FROM ros:foxy-perception

LABEL maintainer="lightning-lm M20 adaptation"
LABEL description="A docker for lightning-lm on M20 (Ubuntu 20.04 + ROS2 Foxy / RK3588 ARM-ready)"

# 环境变量
ENV ROS_WS=/root/slam_ws

# 使用 focal (20.04) 国内镜像源
RUN printf "deb https://mirrors.ustc.edu.cn/ubuntu/ focal main restricted universe multiverse\n\
deb-src https://mirrors.ustc.edu.cn/ubuntu/ focal main restricted universe multiverse\n\
deb https://mirrors.ustc.edu.cn/ubuntu/ focal-updates main restricted universe multiverse\n\
deb-src https://mirrors.ustc.edu.cn/ubuntu/ focal-updates main restricted universe multiverse\n\
deb https://mirrors.ustc.edu.cn/ubuntu/ focal-backports main restricted universe multiverse\n\
deb-src https://mirrors.ustc.edu.cn/ubuntu/ focal-backports main restricted universe multiverse\n\
deb https://mirrors.ustc.edu.cn/ubuntu/ focal-security main restricted universe multiverse\n\
deb-src https://mirrors.ustc.edu.cn/ubuntu/ focal-security main restricted universe multiverse\n" > /etc/apt/sources.list && \
    apt-get update && \
    rm -rf /var/lib/apt/lists/*

RUN apt update && apt install -y \
    cmake \
    make \
    g++ \
    gcc \
    libssl-dev \
    libboost-all-dev \
    libboost-dev \
    libeigen3-dev \
    libpcl-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libopencv-dev \
    libyaml-cpp-dev \
    pcl-tools \
    libtbb-dev \
    liboctomap-dev \
    libassimp-dev \
    liburdfdom-dev \
    libepoxy-dev \
    doxygen \
    python3-pip \
    python3-wheel \
    python3-setuptools \
    ros-${ROS_DISTRO}-pcl-conversions \
    ros-${ROS_DISTRO}-pcl-ros \
    ros-${ROS_DISTRO}-rosbag2-cpp \
    ros-${ROS_DISTRO}-rosbag2-storage \
    ros-${ROS_DISTRO}-rosbag2-storage-default-plugins \
    zip \
    && rm -rf /var/lib/apt/lists/*

# 安装Pangolin库（0.9.3 兼容 focal）
WORKDIR /tmp

RUN git clone --recurse-submodules https://github.com/stevenlovegrove/Pangolin.git && \
    cd Pangolin && \
    mkdir build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_WITH_COLLISION_SUPPORT=ON \
        -DBUILD_PYTHON_INTERFACE=OFF && \
    make -j$(nproc) && \
    make install && \
    cd / && \
    rm -rf /tmp/Pangolin

# 创建 ROS 工作空间
WORKDIR ${ROS_WS}

# 复制本地源码（包含 M20 适配：轮速融合、/lio_pose、/ODOM、occ_grid、use_sim_time
# /sensor_best_effort 键及 launch/default_m20.yaml 等本地提交）。
# 构建时必须把 lightning-lm 源码根目录作为 build context：
#   docker build -f docker/Dockerfile.foxy .
# 注意：不要改回 clone 上游 gaoxiang12/lightning-lm，那会丢失全部 M20 适配。
COPY . src/lightning-lm

# 一键式构建命令
RUN /bin/bash -c "source /opt/ros/${ROS_DISTRO}/setup.bash && \
    colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && \
    echo 'source /root/slam_ws/install/setup.bash' >> ~/.bashrc && \
    echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> ~/.bashrc"
