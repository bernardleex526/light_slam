<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>m20_navigation</name>
  <version>1.0.0</version>
  <description>
    M20 Pro autonomous navigation stack: Terrain Traversability Analysis,
    Global Planner (Omnidirectional Hybrid A*), Local Controller (DWA + LinePlanner),
    and native DrDDS bridge for the M20 Pro quadruped robot.
    Ported from m20_orignal with alignment to the M20 Pro baseline reference.
  </description>
  <maintainer email="bernardx526@example.com">bernardx526</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>libpcl-all-dev</depend>

  <!-- drdds is optional: present on the M20 robot (via source setup_ros2.sh),
       absent on dev machines. CMakeLists uses find_package(drdds QUIET). -->
  <depend condition="$M20_HAS_DRDDS == 1">drdds</depend>

  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>